APP_ENV=development
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:15432/ai_support
DATABASE_REPLICA_URL=postgresql+asyncpg://analytics_reader:analytics_pass@localhost:15433/ai_support
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=86400
REDIS_USER_CONTEXT_TTL_SECONDS=604800
REDIS_CHAT_MEMORY_URL=redis://localhost:6379/1
REDIS_CHAT_MEMORY_TTL_SECONDS=1800
RATE_LIMIT_USER_MESSAGES_PER_MINUTE=10
RATE_LIMIT_IP_REQUESTS_PER_MINUTE=1000
REDIS_QUEUE_URL=redis://localhost:6379/2
QUEUE_MAX_RETRY_ATTEMPTS=3
QUEUE_RETRY_BASE_SECONDS=1
QUEUE_CONSUMER_BLOCK_MS=5000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CHAT_GREETING_MESSAGE=Hi there! Welcome to AI Customer Support. How can we help you today?
CHAT_INACTIVITY_TRIGGER_SECONDS=30
BACKUP_DIR=./backups/postgres
BACKUP_RETENTION_DAYS=35
WAL_ARCHIVE_DIR=./backups/wal_archive
OPENAI_API_KEY=