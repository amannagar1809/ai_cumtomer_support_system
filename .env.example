# Application
APP_ENV=development
APP_PORT=8000

# PostgreSQL (Docker — host port 15432)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:15432/ai_support
DATABASE_REPLICA_URL=postgresql+asyncpg://analytics_reader:analytics_pass@localhost:15433/ai_support

# Redis DB 0 — sessions, user context
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=86400
REDIS_USER_CONTEXT_TTL_SECONDS=604800

# Redis DB 1 — chat memory
REDIS_CHAT_MEMORY_URL=redis://localhost:6379/1
REDIS_CHAT_MEMORY_TTL_SECONDS=1800

# Backup
BACKUP_DIR=./backups/postgres
BACKUP_RETENTION_DAYS=35
WAL_ARCHIVE_DIR=./backups/wal_archive

OPENAI_API_KEY=